          "channel",
          "destination_hint",
          "expires_at",
          "attempts_remaining",
          "disclaimer"
        ],
        "title": "VerificationOut",
        "type": "object"
      },
      "VerifyRequest": {
        "additionalProperties": false,
        "properties": {
          "challenge_id": {
            "format": "uuid",
            "title": "Challenge Id",
            "type": "string"
          },
          "code": {
            "maxLength": 12,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "code"
        ],
        "title": "VerifyRequest",
        "type": "object"
      }
    }
  },
