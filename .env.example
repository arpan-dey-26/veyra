# VEYRA environment template. Copy to .env and NEVER commit .env.
# Values here are safe local-development defaults only.
# (Comments are kept on their own lines so every dotenv parser reads values cleanly.)

# ---- API ----
# One of: dev | test | demo | production
VEYRA_ENV=dev
VEYRA_APP_VERSION=0.0.0-phase0
VEYRA_LOG_LEVEL=INFO
# Required (>= 32 chars, not this placeholder) when VEYRA_ENV=production
VEYRA_SECRET_KEY=change-me-dev-only-not-a-real-secret-000000
VEYRA_DATABASE_URL=postgresql+asyncpg://veyra:veyra@localhost:55432/veyra
VEYRA_REDIS_URL=redis://localhost:56379/0
VEYRA_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Verification provider (implemented in Phase 1).
# demo_last4 = DEMO ONLY (last 4 digits of mobile). Refused at startup when VEYRA_ENV=production.
VEYRA_VERIFICATION_PROVIDER=demo_last4

# ---- Web ----
NEXT_PUBLIC_VEYRA_ENV=dev
# Where the Next.js server proxies /api/* (server-side only, never exposed to the browser)
VEYRA_API_INTERNAL_URL=http://localhost:8000

# ---- docker-compose Postgres (local only) ----
POSTGRES_USER=veyra
POSTGRES_PASSWORD=veyra
POSTGRES_DB=veyra
# Host ports (non-default to avoid clashing with a local Postgres/Redis)
VEYRA_PG_PORT=55432
VEYRA_REDIS_PORT=56379
